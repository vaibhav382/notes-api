generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String       @id @default(uuid())
  email      String       @unique
  name       String
  password   String
  notes      Note[]
  createdAt  DateTime     @default(now())
  updatedAt DateTime      @updatedAt
  @@index([email])
}

model Note {
  id         String       @id @default(uuid())
  title      String
  content    String
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  @@index([userId])
  @@index([createdAt])
}
